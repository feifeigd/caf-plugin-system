# ============================================================================
# C++ / CMake 构建产物
# ============================================================================

# 构建目录（CMake / 各 IDE 默认）
/build/
out/
/cmake-build-*/
/Debug/
/Release/
/RelWithDebInfo/
/MinSizeRel/
/x64/
/x86/

# CMake 生成文件
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Testing/
Makefile
makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/

# Ninja
.ninja_deps
.ninja_log

# Visual Studio
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.sln
.vs/

# Xcode
*.xcodeproj/
*.xcworkspace/
DerivedData/

# ============================================================================
# 编译产物
# ============================================================================

# 对象文件 / 静态库 / 动态库
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dll
*.dylib
*.exe
*.out
*.app

# 预编译头
*.gch
*.pch

# ============================================================================
# IDE / 编辑器
# ============================================================================

# VS Code（保留用户设置，忽略工作区缓存）
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# CLion / JetBrains
.idea/
*.iml

# Visual Studio 用户文件
*.user
*.userosscache
*.suo
*.db
*.opendb
*.opensdf
*.sdf
*.cachefile

# ============================================================================
# vcpkg（保留清单，忽略构建缓存）
# ============================================================================

# vcpkg 自动下载的依赖源码和构建产物
vcpkg_installed/

# ============================================================================
# 测试 / 运行时数据
# ============================================================================

# 手工组装的运行目录（exe + DLL + plugins/ + updates/ + checkpoints/ + 日志）
/run/
run_worker/
run_bridge/
# 集群/桥接测试的多轮运行目录（run2、run3b 等）
run[0-9]*/
run[0-9]*b/

# 测试生成的检查点文件
/checkpoints/
*.ckpt

# 日志
*.log

